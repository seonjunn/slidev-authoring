{
  "name": "slidev-addon-authoring",
  "version": "0.1.0",
  "type": "module",
  "description": "Markdown citations, a local figure highlight editor, and PowerPoint export for Slidev",
  "repository": {
    "type": "git",
    "url": "https://github.com/seonjunn/slidev-authoring.git"
  },
  "keywords": [
    "slidev-addon",
    "slidev"
  ],
  "engines": {
    "node": ">=22.12.0",
    "slidev": "52.19.1"
  },
  "bin": {
    "slidev-pptx": "./bin/slidev-pptx.mjs"
  },
  "exports": {
    "./vite": "./vite.mjs",
    "./markdown": "./lib/markdown.mjs"
  },
  "files": [
    "bin",
    "components",
    "editor",
    "lib",
    "pptx",
    "styles",
    "vite.mjs",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "mathml2omml": "^0.5.0"
  },
  "peerDependencies": {
    "@slidev/client": "52.19.1",
    "@slidev/parser": "52.19.1",
    "vue": "^3.5.0",
    "@slidev/cli": "52.19.1",
    "playwright-chromium": "^1.55.0"
  },
  "peerDependenciesMeta": {
    "@slidev/cli": {
      "optional": true
    },
    "playwright-chromium": {
      "optional": true
    }
  },
  "devDependencies": {
    "@slidev/client": "52.19.1",
    "@slidev/parser": "52.19.1",
    "markdown-exit": "^1.0.0",
    "vue": "^3.5.0"
  }
}
